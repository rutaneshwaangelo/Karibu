PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/karibu
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=24h

# Allowed browser origins. Comma-separate multiple values to allow preview
# deployments alongside production, e.g.
# CLIENT_URL=https://karibu.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# Required in production: shared secret that authenticates the queue-engine
# cron job. Vercel Cron sends it automatically as `Authorization: Bearer <value>`
# when this variable is set in the project's environment variables.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

NODE_ENV=development
